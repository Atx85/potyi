+impl vt100::ScrollbackSink for Capture {
+    fn push(&mut self, cols: u16, wrapped: bool, formatted: &[u8]) {
+        let Some(origin) = &self.active else {
+            return;
+        };
+        if self.failed {
+            return;
+        }
+        if let Err(error) = self.transcript.lock().unwrap().append_terminal(
+            &origin.directory,
+            origin.source,
+            cols,
+            wrapped,

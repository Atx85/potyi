+        mods: sdl3::keyboard::Mod,
+        clipboard: &sdl3::clipboard::ClipboardUtil,
+        vim: bool,
+    ) -> Option<crate::experimental_terminal::pane::Action> {
+        let pane = self.experimental.as_mut()?;

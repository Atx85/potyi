+fn drain(browser: &mut Browser) {
+    let deadline = Instant::now() + Duration::from_secs(30);
+    while browser.working() {
+        if !browser.poll() {
+            thread::sleep(Duration::from_millis(1));
+        }
+        assert!(Instant::now() < deadline, "Git view timed out");

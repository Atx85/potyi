+    assert!(
+        resolve(
+            click,
+            &f.store,
+            &mut source,
+            &f.provenance,
+            &AtomicBool::new(false)
+        )
+        .unwrap()
+        .is_none()
+    );
+    assert!(source.reads <= MAX_LINE_ROWS + 1);
+    assert!(source.reads <= MAX_LINE_BYTES / 512 + 1);
+}

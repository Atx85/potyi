+    let mut projected = layout(shared.clone(), 79);
+    let bottom = projected.len() - 4;
+    let retained = view(&mut projected, bottom, 4);
+    let previous_base = projected.base;
+    while shared.lock().unwrap().base_id() == previous_base {
+        shared
+            .lock()
+            .unwrap()

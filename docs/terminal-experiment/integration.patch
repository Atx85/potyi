+fn line_decoding_and_git_colors_are_chunk_independent_and_bounded() {
+    let bytes=b"\x1b[31mcommit abc1234\x1b[0m\r\n\x1b]0;hidden\x07@@ hunk\n+\xe6\x9d\xb1\xe4\xba\xac\n-old\n\nlast";
+    let collect = |chunks: Vec<&[u8]>| {

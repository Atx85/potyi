+        detail_rows
+            .iter()
+            .filter_map(|record| match &record.data {
+                RecordData::Native(bytes) => Some(decode_native(bytes).unwrap()),
+                _ => None,
+            })
+            .any(|row| row.text == "+new" && row.color == Some((150, 220, 165)))

+        for chunk in chunks {
+            lines
+                .push(chunk, |text| {
+                    result.push((text.to_owned(), colors.line(text)));
+                    Ok(())
+                })
+                .unwrap();
+        }
+        lines
+            .finish(|text| {
+                result.push((text.to_owned(), colors.line(text)));
+                Ok(())
+            })
+            .unwrap();
+        result
+    };
+    let whole = collect(vec![bytes]);

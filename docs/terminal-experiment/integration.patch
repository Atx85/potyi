+        cwd: &Path,
+        source: u64,
+        text: &str,
+        continued: bool,
+    ) -> io::Result<Anchor> {
+        self.validate_append(cwd, 1, text.as_bytes())?;
+        let change = self.colors.row(source, text, continued, Some(self.history.serial));
+        let anchor = self.append_styled(cwd, source, 1, 0, continued, 0,

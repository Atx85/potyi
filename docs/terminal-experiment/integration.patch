+    pub(crate) fn ris(&mut self) {
+        let sink = self.grid.scrollback_sink();
+        self.grid.clear_external_scrollback();
+        *self = Self::new(self.grid.size(), self.grid.scrollback_len());
+        if let Some(sink) = sink {
+            self.grid.set_scrollback_sink(sink);
+        }

+        .unwrap_or(if visible { 2000 } else { 0 });
+    assert!(hold_ms <= 10_000);
+
+    with_fixture(|app| {
+        let sdl = sdl3::init().unwrap();
+        let video = sdl.video().unwrap();
+        let driver = video.current_video_driver();
+        if visible {
+            assert_ne!(
